{
  "name": "dsh-session-delete",
  "version": "1.0.0",
  "description": "Add a permanent Delete session action to the sidebar session context menu, behind a confirmation dialog.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wilsonchengassistant/dsh-session-delete.git"
  },
  "homepage": "https://github.com/wilsonchengassistant/dsh-session-delete#readme",
  "bugs": {
    "url": "https://github.com/wilsonchengassistant/dsh-session-delete/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin"
  ],
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "files": [
    "cordis.patch.yml",
    "lib/index.js",
    "lib/client.js",
    "locale/*.json"
  ]
}
